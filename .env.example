# Copy to .env to override compose.yaml values or run commands from the host.
# Never commit the .env file to version control.

# Ports exposed on the host (change them if already in use)
APP_PORT=3000
DEBUG_PORT=9229
POSTGRES_PORT=5432
MAILPIT_UI_PORT=8025
MAILPIT_SMTP_PORT=1025

# Use for commands run from the host (e.g. `npx prisma studio`).
# Inside the container, compose already sets DATABASE_URL with host "postgres".
# DATABASE_URL=postgresql://quadrevo:quadrevo@localhost:5432/quadrevo?schema=public
